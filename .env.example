# Copy this file to .env and adjust as needed. Names only — no real secrets.
# .env is gitignored; never commit real values.

# --- Application mode -------------------------------------------------------
# DEMO_MODE is the only supported mode in this prototype. See
# docs/TECH_STACK_AND_ZERO_COST_POLICY.md for the PILOT_MODE distinction.
APP_MODE=DEMO_MODE

# --- Django -------------------------------------------------------------
# config.settings.dev is the local/demo-package default (see docs/DEMO_PACKAGE.md). A public demo
# deployment (see docs/HOSTING_OPTIONS.md — no such deployment exists yet) would instead use
# config.settings.demo.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# --- Database (PostgreSQL / PostGIS via compose "db" service) -----------
# "medrelay:medrelay" below is a synthetic local-dev-only placeholder, not a real credential.
# pragma: allowlist nextline secret
DATABASE_URL=postgres://medrelay:medrelay@db:5432/medrelay
POSTGRES_DB=medrelay
POSTGRES_USER=medrelay
POSTGRES_PASSWORD=medrelay

# --- Cache / Celery broker (Valkey, Redis-protocol-compatible) ----------
REDIS_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/0
CELERY_RESULT_BACKEND=redis://valkey:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (local Mailpit SMTP capture) ----------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# --- Production-only (config/settings/prod.py); leave unset for local dev ---
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SECURE_HSTS_SECONDS=

# --- Demo-only (config/settings/demo.py); leave unset for local dev/prod ---
# Phase 9 abuse safeguard — see docs/DEMO_PACKAGE.md "Quota/abuse safeguards".
DEMO_MAX_DELIVERY_REQUESTS_PER_ORG=
DEMO_SESSION_COOKIE_AGE=
